#!/usr/bin/env bash
# Stage-0 downloads one versioned Stage-1 asset over HTTPS.
set -euo pipefail

fail() {
  echo "install-node: $1" >&2
  exit 1
}

usage() {
  echo "usage: install-node --version vX.Y.Z [--root-lifecycle]" >&2
  exit 2
}

download() {
  local url="$1" output="$2"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
      --output "${output}" "${url}"
  elif command -v wget >/dev/null 2>&1; then
    wget --https-only --secure-protocol=TLSv1_2 --quiet --output-document="${output}" "${url}"
  else
    fail "curl or wget is required"
  fi
}

main() {
  local version="" version_seen=false root_lifecycle=false
  local base asset url temporary cleanup_parent cleanup_directory command_name
  local -a stage1_args=()

  umask 077

  while (($# > 0)); do
    case "$1" in
      --version)
        [[ "${version_seen}" == false && $# -ge 2 ]] || usage
        version="$2"
        version_seen=true
        shift 2
        ;;
      --root-lifecycle)
        [[ "${root_lifecycle}" == false ]] || usage
        root_lifecycle=true
        stage1_args+=(--root-lifecycle)
        shift
        ;;
      *) usage ;;
    esac
  done
  [[ "${version_seen}" == true ]] || usage
  [[ "${version}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    fail "an exact stable vX.Y.Z release is required"
  for command_name in mktemp chmod rm sleep; do
    command -v "${command_name}" >/dev/null 2>&1 || fail "${command_name} is required"
  done

  base="https://github.com/GentleKingson/ocservia/releases/download"
  asset="managed-node-bootstrap.sh"
  url="${base}/${version}"
  temporary="$(mktemp -d)" || fail "cannot create a temporary directory"
  trap 'rm -rf -- "${temporary}"' EXIT
  trap 'exit 1' HUP INT TERM

  download "${url}/${asset}" "${temporary}/${asset}" || fail "Stage-1 download failed"
  [[ -s "${temporary}/${asset}" ]] || fail "Stage-1 download is empty"

  chmod 0700 -- "${temporary}/${asset}"
  stage1_args=(--version "${version}" "${stage1_args[@]}")
  cleanup_parent="${BASHPID}"
  cleanup_directory="${temporary}"
  # exec replaces Stage-0, so a minimal watcher owns post-Stage-1 cleanup.
  (
    trap - EXIT
    trap '' HUP INT TERM
    while kill -0 "${cleanup_parent}" 2>/dev/null; do sleep 1; done
    rm -rf -- "${cleanup_directory}"
  ) >/dev/null 2>&1 &
  exec "${temporary}/${asset}" "${stage1_args[@]}"
}

main "$@"
