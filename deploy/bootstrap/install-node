#!/usr/bin/env bash
# Bootstrap launcher: download one versioned installer asset over HTTPS.
set -euo pipefail
readonly DEFAULT_VERSION=""

fail() {
  echo "install-node: $1" >&2
  exit 1
}

usage() {
  echo "No arguments: interactive wizard (TTY required). --non-interactive: unattended, no prompts." >&2
  echo "Options: --config PATH (default ./install.env), --version vX.Y.Z (Release default embedded)." >&2
  echo "usage: install-node --version vX.Y.Z [--root-lifecycle]" >&2
  exit 2
}

download() {
  local url="$1" output="$2"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
      --output "${output}" "${url}"
  elif command -v wget >/dev/null 2>&1; then
    wget --https-only --secure-protocol=TLSv1_2 --quiet --output-document="${output}" "${url}"
  else
    fail "curl or wget is required"
  fi
}

main() {
  local version="" version_seen=false root_lifecycle=false
  local base asset url temporary cleanup_parent cleanup_directory command_name
  local -a installer_args=()

  umask 077
  if (($# == 0)); then
    [[ -t 0 && -t 1 ]] || fail "interactive installation requires a TTY; use --non-interactive"
    stage1_args+=(--interactive)
  fi

  while (($# > 0)); do
    case "$1" in
      --non-interactive)
        stage1_args+=(--non-interactive); shift ;;
      --config)
        [[ $# -ge 2 && -f "$2" ]] || fail "--config requires an existing file"
        stage1_args+=(--config "$2"); shift 2 ;;
      --help|-h) usage ;;
      --version)
        [[ "${version_seen}" == false && $# -ge 2 ]] || usage
        version="$2"
        version_seen=true
        shift 2
        ;;
      --root-lifecycle)
        [[ "${root_lifecycle}" == false ]] || usage
        root_lifecycle=true
        installer_args+=(--root-lifecycle)
        shift
        ;;
      *) usage ;;
    esac
  done
  if [[ "${version_seen}" == false ]]; then
    version="${DEFAULT_VERSION}"
  fi
  [[ -n "${version}" ]] || fail "this source copy has no default release; pass --version vX.Y.Z"
  [[ "${version}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-rc[.][1-9][0-9]*)?$ ]] ||
    fail "an exact vX.Y.Z or vX.Y.Z-rc.N release is required"
  for command_name in mktemp chmod rm sleep; do
    command -v "${command_name}" >/dev/null 2>&1 || fail "${command_name} is required"
  done

  base="https://github.com/GentleKingson/ocservia/releases/download"
  asset="managed-node-bootstrap.sh"
  url="${base}/${version}"
  temporary="$(mktemp -d)" || fail "cannot create a temporary directory"
  trap 'rm -rf -- "${temporary}"' EXIT
  trap 'exit 1' HUP INT TERM

  download "${url}/${asset}" "${temporary}/${asset}" || fail "versioned installer download failed"
  [[ -s "${temporary}/${asset}" ]] || fail "versioned installer download is empty"

  chmod 0700 -- "${temporary}/${asset}"
  installer_args=(--version "${version}" "${installer_args[@]}")
  cleanup_parent="${BASHPID}"
  cleanup_directory="${temporary}"
  # exec replaces the launcher; a watcher cleans up after the installer exits.
  (
    trap - EXIT
    trap '' HUP INT TERM
    while kill -0 "${cleanup_parent}" 2>/dev/null; do sleep 1; done
    rm -rf -- "${cleanup_directory}"
  ) >/dev/null 2>&1 &
  exec "${temporary}/${asset}" "${installer_args[@]}"
}

main "$@"
