{
	admin off
	auto_https off
	servers {
		timeouts {
			read_header 5s
			read_body 30s
		}
	}
}

:8443 {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	handle /api/* {
		reverse_proxy control-plane:8080
	}
	handle /healthz {
		reverse_proxy control-plane:8080
	}
	handle /readyz {
		reverse_proxy control-plane:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
