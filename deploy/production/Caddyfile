{
	admin off
	auto_https off
	servers {
		protocols h1 h2
		timeouts {
			read_header 5s
			read_body 30s
		}
	}
}

:8443 {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key
	@nonStream not path /api/v1/events/stream /api/v1/operations/*/events
	encode @nonStream zstd gzip {
		minimum_length 512
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
	# A handler error (such as an unreachable control plane) is written without
	# the deferred header block above, so error responses repeat it unchanged.
	handle_errors {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
			-Server
		}
	}
	handle /api/* {
		reverse_proxy control-plane:8080 {
			transport http {
				keepalive 55s
			}
			header_up X-Ocservia-Client-IP {http.request.remote.host}
		}
	}
	handle /healthz {
		reverse_proxy control-plane:8080
	}
	handle /readyz {
		reverse_proxy control-plane:8080
	}
	handle {
		root * /srv
		@viteAsset {
			path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.[^/]+$
			file
		}
		header @viteAsset Cache-Control "public, max-age=31536000, immutable"
		# Revalidate every HTML response (including the try_files fallback) so a
		# redeploy is seen at once: the page names its build's hashed assets.
		header {
			match {
				header Content-Type text/html*
			}
			Cache-Control "no-cache"
		}
		try_files {path} /index.html
		file_server
	}
}
