{
	admin off
	auto_https off
	servers {
		timeouts {
			read_header 5s
			read_body 30s
		}
	}
}

:8443 {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy-Report-Only "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
	handle /api/* {
		reverse_proxy control-plane:8080 {
			header_up X-Ocservia-Client-IP {http.request.remote.host}
		}
	}
	handle /healthz {
		reverse_proxy control-plane:8080
	}
	handle /readyz {
		reverse_proxy control-plane:8080
	}
	handle {
		root * /srv
		# Revalidate every HTML response (including the try_files fallback) so a
		# redeploy is seen at once: the page names its build's hashed assets.
		header {
			match {
				header Content-Type text/html*
			}
			Cache-Control "no-cache"
		}
		try_files {path} /index.html
		file_server
	}
}
