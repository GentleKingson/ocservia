worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 2048; }

stream {
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 2s;
    map $ssl_preread_server_name $destination {
        ${OCSERV_PUBLIC_HOST} gateway:8443;
        ${OCSERV_RELAY_PUBLIC_HOST} 127.0.0.1:9443;
        default 127.0.0.1:9444;
    }
    server {
        listen 8443;
        ssl_preread on;
        preread_timeout 5s;
        proxy_connect_timeout 5s;
        proxy_timeout 35m;
        proxy_pass $destination;
        proxy_protocol on;
    }
    # Relay does not parse PROXY. Strip it only on an unreachable loopback hop.
    server {
        listen 127.0.0.1:9443 proxy_protocol;
        set $relay relay:8443;
        proxy_pass $relay;
        proxy_protocol off;
        proxy_connect_timeout 5s;
        proxy_timeout 35m;
    }
    server {
        listen 127.0.0.1:9444;
        return "";
    }
}
