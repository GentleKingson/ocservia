CONTROLLER_ENDPOINT_ID=replace-with-approved-controller-endpoint-id
NODE_ID=00000000-0000-7000-8000-000000000000
CONTROLLER_COMMAND_VERIFICATION_KEY_FILE=/etc/ocservia-agent/controller-command-verification-key.pem
USER_PASSWORD_SEAL_KEY_ID=user-key-v1
USER_PASSWORD_SEAL_PUBLIC_KEY_SHA256=replace-with-64-lowercase-hex-sha256
P12_PASSWORD_SEAL_KEY_ID=p12-key-v1
P12_PASSWORD_SEAL_PUBLIC_KEY_SHA256=replace-with-distinct-64-lowercase-hex-sha256
