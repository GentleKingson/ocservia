{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocservia.example/schemas/g6-assembly-result-schema.json",
  "title": "Ocservia G6 Evidence Assembly Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_sha",
    "run_id",
    "run_attempt",
    "environment_id",
    "authority",
    "release_manifest_digest",
    "status",
    "exit_code",
    "reason"
  ],
  "properties": {
    "schema_version": { "const": "ocservia.g6-assembly-result.v1" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "environment_id": { "type": "string", "pattern": "^g6-[a-z0-9]{8,32}$" },
    "authority": { "enum": ["engineering", "production_readiness"] },
    "release_manifest_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["passed", "failed"] },
    "exit_code": { "type": "integer", "minimum": 0 },
    "reason": { "type": ["string", "null"] }
  }
}
