{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocservia.example/schemas/g6-builder-source-inventory-schema.json",
  "title": "Ocservia G6 Builder Source Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": "ocservia.g6-builder-source-inventory.v1" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
