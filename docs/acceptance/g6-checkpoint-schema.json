{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GentleKingson/ocservia/docs/acceptance/g6-checkpoint-schema.json",
  "title": "Ocservia G6 Checkpoint Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_name",
    "checkpoint",
    "sequence",
    "producer_domain",
    "candidate_sha",
    "run_id",
    "run_attempt",
    "environment_id",
    "authority",
    "created_at",
    "expires_at",
    "payloads"
  ],
  "properties": {
    "schema_version": { "const": "ocservia.g6-checkpoint.v1" },
    "artifact_name": {
      "type": "string",
      "pattern": "^g6-rd-[a-z0-9-]+-[1-9][0-9]*-[1-9][0-9]*$"
    },
    "checkpoint": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "producer_domain": { "enum": ["fd-a", "fd-b"] },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "environment_id": {
      "type": "string",
      "pattern": "^g6-[a-z0-9]{8,32}$"
    },
    "authority": { "enum": ["engineering", "production_readiness"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
