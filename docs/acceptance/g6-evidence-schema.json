{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocservia.dev/schemas/g6-evidence-v1.json",
  "title": "ocservia G6 evidence verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_sha",
    "release_manifest_digest",
    "slo_contract_digest",
    "topology_digest",
    "started_at",
    "finished_at",
    "environment",
    "measurements",
    "observations",
    "artifacts",
    "passed"
  ],
  "properties": {
    "schema_version": { "const": "ocservia.g6-evidence.v1" },
    "candidate_sha": { "$ref": "#/$defs/sha" },
    "release_manifest_digest": { "$ref": "#/$defs/digest" },
    "slo_contract_digest": { "$ref": "#/$defs/digest" },
    "topology_digest": { "$ref": "#/$defs/digest" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "failure_domain_class", "authority"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "failure_domain_class": {
          "enum": ["single_host", "multi_host", "multi_zone", "multi_region"]
        },
        "authority": { "enum": ["engineering", "production_readiness"] },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        }
      }
    },
    "measurements": {
      "type": "object",
      "required": [
        "stability_window_seconds",
        "authorized_real_agents",
        "max_production_command_inflight",
        "synthetic_command_completion_seconds_p99",
        "stale_owner_accepts",
        "stale_scheduler_commits",
        "concurrent_active_scheduler_leaders",
        "duplicate_remote_effects",
        "acknowledged_transaction_loss",
        "unreconciled_outbox_rows",
        "unreconciled_unknown_commands",
        "quarantined_unmatched_command_results",
        "database_rpo_seconds",
        "database_rto_seconds",
        "connection_owner_takeover_seconds",
        "scheduler_takeover_seconds",
        "relay_takeover_seconds",
        "reconnect_storm_recovery_seconds",
        "read_api_success_ratio",
        "enqueue_success_ratio",
        "enqueue_latency_seconds_p95",
        "telemetry_fresh_ratio",
        "telemetry_fresh_age_seconds",
        "command_dispatch_ratio",
        "command_dispatch_seconds",
        "audit_completeness_ratio",
        "terminal_or_reconciled_operation_ratio",
        "controller_rss_growth_ratio",
        "transportd_rss_growth_ratio",
        "agent_rss_growth_ratio",
        "controller_fd_growth",
        "transportd_fd_growth",
        "agent_fd_growth",
        "controller_goroutine_growth",
        "transportd_tokio_task_growth",
        "agent_tokio_task_growth",
        "database_connection_growth",
        "queue_depth_end",
        "outbox_oldest_age_seconds_end"
      ],
      "propertyNames": {
        "enum": [
          "stability_window_seconds",
          "authorized_real_agents",
          "max_production_command_inflight",
          "synthetic_command_completion_seconds_p99",
          "stale_owner_accepts",
          "stale_scheduler_commits",
          "concurrent_active_scheduler_leaders",
          "duplicate_remote_effects",
          "acknowledged_transaction_loss",
          "unreconciled_outbox_rows",
          "unreconciled_unknown_commands",
          "quarantined_unmatched_command_results",
          "database_rpo_seconds",
          "database_rto_seconds",
          "connection_owner_takeover_seconds",
          "scheduler_takeover_seconds",
          "relay_takeover_seconds",
          "reconnect_storm_recovery_seconds",
          "read_api_success_ratio",
          "enqueue_success_ratio",
          "enqueue_latency_seconds_p95",
          "telemetry_fresh_ratio",
          "telemetry_fresh_age_seconds",
          "command_dispatch_ratio",
          "command_dispatch_seconds",
          "audit_completeness_ratio",
          "terminal_or_reconciled_operation_ratio",
          "controller_rss_growth_ratio",
          "transportd_rss_growth_ratio",
          "agent_rss_growth_ratio",
          "controller_fd_growth",
          "transportd_fd_growth",
          "agent_fd_growth",
          "controller_goroutine_growth",
          "transportd_tokio_task_growth",
          "agent_tokio_task_growth",
          "database_connection_growth",
          "queue_depth_end",
          "outbox_oldest_age_seconds_end"
        ]
      },
      "additionalProperties": { "$ref": "#/$defs/measurement" }
    },
    "observations": {
      "type": "object",
      "required": [
        "database_failover",
        "dual_primary_prevention",
        "pitr_target_restore",
        "connection_owner_failover",
        "stale_owner_rejection",
        "scheduler_leader_failover",
        "stale_scheduler_rejection",
        "relay_failover",
        "direct_to_relay",
        "relay_to_direct",
        "reconnect_storm",
        "outbox_crash_recovery"
      ],
      "propertyNames": {
        "enum": [
          "database_failover",
          "dual_primary_prevention",
          "pitr_target_restore",
          "connection_owner_failover",
          "stale_owner_rejection",
          "scheduler_leader_failover",
          "stale_scheduler_rejection",
          "relay_failover",
          "direct_to_relay",
          "relay_to_direct",
          "reconnect_storm",
          "outbox_crash_recovery"
        ]
      },
      "additionalProperties": { "$ref": "#/$defs/observation" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "passed": { "type": "boolean" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual", "limit", "comparison", "unit", "passed"],
      "properties": {
        "actual": { "type": "number" },
        "limit": { "type": "number" },
        "comparison": { "enum": ["lte", "gte", "eq"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "passed", "timeline_event_ids"],
      "properties": {
        "observed": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "timeline_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        },
        "notes": { "type": "string", "maxLength": 1024 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest", "media_type"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "digest": { "$ref": "#/$defs/digest" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
