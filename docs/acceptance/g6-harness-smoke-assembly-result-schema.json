{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GentleKingson/ocservia/docs/acceptance/g6-harness-smoke-assembly-result-schema.json",
  "title": "G6 harness smoke assembly result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "binding", "bundle_sha256", "status", "formal_verdict_eligible", "failure"],
  "properties": {
    "schema_version": { "const": "ocservia.g6-harness-smoke-assembly-result.v1" },
    "profile": { "const": "smoke" },
    "binding": { "$ref": "g6-harness-smoke-result-schema.json#/$defs/binding" },
    "bundle_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["passed", "failed"] },
    "formal_verdict_eligible": { "const": false },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } } }
      ]
    }
  }
}
