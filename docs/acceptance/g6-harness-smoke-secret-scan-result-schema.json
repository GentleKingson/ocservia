{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GentleKingson/ocservia/docs/acceptance/g6-harness-smoke-secret-scan-result-schema.json",
  "title": "G6 harness smoke secret scan result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "binding", "status", "formal_verdict_eligible"],
  "properties": {
    "schema_version": { "const": "ocservia.g6-harness-smoke-secret-scan-result.v1" },
