{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GentleKingson/ocservia/docs/acceptance/g6-runtime-state-schema.json",
  "title": "Ocservia G6 Runtime State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "binding", "status", "current_sequence", "completed_phases", "manifested_checkpoints", "consumed_checkpoints", "updated_at"],
  "properties": {
    "schema_version": { "const": "ocservia.g6-runtime-state.v1" },
    "domain": { "enum": ["fd-a", "fd-b"] },
    "binding": { "$ref": "#/$defs/binding" },
    "status": { "enum": ["running", "completed", "failed"] },
    "current_sequence": { "type": "integer", "minimum": 0 },
    "completed_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sequence", "completed_at"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "sequence": { "type": "integer", "minimum": 1 },
          "completed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "manifested_checkpoints": { "$ref": "#/$defs/checkpoints" },
    "consumed_checkpoints": { "$ref": "#/$defs/checkpoints" },
    "active_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sequence", "started_at"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "started_at": { "type": "string", "format": "date-time" }
      }
    },
    "failure": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_sha", "run_id", "run_attempt", "environment_id", "authority"],
      "properties": {
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "run_attempt": { "type": "integer", "minimum": 1 },
        "environment_id": { "type": "string", "pattern": "^g6-[a-z0-9]{8,32}$" },
        "authority": { "enum": ["engineering", "production_readiness"] }
      }
    },
    "checkpoints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    }
  }
}
