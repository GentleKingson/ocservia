{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocservia.example/schemas/g6-source-manifest-schema.json",
  "title": "Ocservia G6 Raw Evidence Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_sha",
    "run_id",
    "run_attempt",
    "environment_id",
    "authority",
    "release_manifest_digest",
    "failure_domain",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "ocservia.g6-source-manifest.v1" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "environment_id": { "type": "string", "pattern": "^g6-[a-z0-9]{8,32}$" },
    "authority": { "enum": ["engineering", "production_readiness"] },
    "release_manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "failure_domain": { "enum": ["fd-a", "fd-b"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
