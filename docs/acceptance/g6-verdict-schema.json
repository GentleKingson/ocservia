{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocservia.dev/schemas/g6-verdict-v1.json",
  "title": "ocservia independently computed G6 verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_sha",
    "release_manifest_digest",
    "slo_contract_digest",
    "topology_digest",
    "authority",
    "failure_domain_class",
    "measurement_results",
    "observation_results",
    "failure_reasons",
    "passed"
  ],
  "properties": {
    "schema_version": { "const": "ocservia.g6-verdict.v1" },
    "candidate_sha": { "$ref": "#/$defs/sha" },
    "release_manifest_digest": { "$ref": "#/$defs/digest" },
    "slo_contract_digest": { "$ref": "#/$defs/digest" },
    "topology_digest": { "$ref": "#/$defs/digest" },
    "authority": { "enum": ["engineering", "production_readiness"] },
    "failure_domain_class": {
      "enum": ["single_host", "multi_host", "multi_zone", "multi_region"]
    },
    "measurement_results": {
      "type": "object",
      "minProperties": 43,
      "propertyNames": {
        "$ref": "https://ocservia.dev/schemas/g6-evidence-v1.json#/$defs/metric_name"
      },
      "additionalProperties": { "$ref": "#/$defs/measurement_result" }
    },
    "observation_results": {
      "type": "object",
      "minProperties": 16,
      "propertyNames": {
        "$ref": "https://ocservia.dev/schemas/g6-evidence-v1.json#/$defs/observation_name"
      },
      "additionalProperties": { "$ref": "#/$defs/observation_result" }
    },
    "failure_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "uniqueItems": true
    },
    "passed": { "type": "boolean" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "measurement_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual",
        "limit",
        "comparison",
        "unit",
        "sample_count",
        "source_artifact_digest",
        "passed"
      ],
      "properties": {
        "actual": { "type": "number" },
        "limit": { "type": "number" },
        "comparison": { "enum": ["lte", "gte", "eq"] },
        "unit": { "enum": ["seconds", "count", "ratio"] },
        "sample_count": { "type": "integer", "minimum": 1 },
        "source_artifact_digest": { "$ref": "#/$defs/digest" },
        "passed": { "type": "boolean" }
      }
    },
    "observation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "timeline_event_ids",
        "source_artifact_digest",
        "passed"
      ],
      "properties": {
        "observed": { "type": "boolean" },
        "timeline_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
          "uniqueItems": true
        },
        "source_artifact_digest": { "$ref": "#/$defs/digest" },
        "passed": { "type": "boolean" }
      }
    }
  }
}
