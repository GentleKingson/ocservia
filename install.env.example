# ocservia installer configuration template.
#
# Copy this file to ./install.env in the directory you run the installer
# from (any configuration directory for either versioned installer;
# the release checkout root only when running a checkout installer directly);
# it is git-ignored there and never makes the clean-release-checkout check fail.
#
# Parsing contract (deploy/lib/install-env.sh):
# - Blank lines and lines starting with '#' are ignored; every other line
#   must be KEY=VALUE. A single static outer layer of matching quotes is
#   removed; nothing is ever expanded or executed.
# - Variables exported in the invoking shell always win over this file —
#   including ones explicitly exported empty; keys absent from both fall
#   back to the installer defaults.
# - Any key outside the allowlist of the installer you are running fails
#   closed. KEEP ONLY THE SECTION FOR THE HOST YOU ARE INSTALLING: the
#   The Controller installer rejects unknown keys. Nodes use installation tokens.
#
# This template holds no secrets: protected material (tokens, private
# keys, certificates, passwords) is provisioned through your protected
# channel and referenced by path only.

## Controller (deploy/production/install.sh) ################################
#
# Public hostname and HTTPS address the Controller is served on.
#OCSERV_PUBLIC_HOST=controller.example.com
#OCSERV_HTTPS_ADDRESS=127.0.0.1
#OCSERV_CONTROLLER_PUBLIC_URL=https://controller.example.com
#
# Authentication and browser origin (must match the public HTTPS gateway):
# See docs/operations/authentication.md for single-admin bootstrap.
#OCSERV_PUBLIC_ORIGIN=https://controller.example.com
#OCSERV_SESSION_TTL=8h
# Optional SemVer recommendation; empty means unconfigured. Never schedules upgrades.
#OCSERV_RECOMMENDED_AGENT_VERSION=0.2.0
#OCSERV_LOCAL_AUTH_ENABLED=true
# Compose maps OCSERV_SECRET_DIR/session-key to OCSERV_SESSION_KEY_FILE
# (/run/secrets/session_key). Do not put secret values or bootstrap password
# settings in install.env; admin initialization is a separate one-shot command.
#
# External services.
# Stable gateway IP, outside the dynamic allocation range and inside the subnet.
# Change all three together if the default subnet overlaps an existing network.
#OCSERV_APPLICATION_SUBNET=172.30.240.0/24
#OCSERV_APPLICATION_IP_RANGE=172.30.240.128/25
#OCSERV_GATEWAY_APPLICATION_IP=172.30.240.2
# Unset: Compose trusts the gateway IP above as /32. Explicit empty: trust none.
#OCSERV_AUTH_TRUSTED_PROXY_CIDRS=172.30.240.2/32
#OCSERV_CERTIFICATE_SIGNER_URL=https://pki.example.com/v1
# Integrated Signer certificate validity, from 24h through 8760h.
#OCSERV_SIGNER_CERT_TTL=2160h
# Optional observability: unset/empty disables OTEL; a nonempty endpoint enables it.
# Requires otel-client.crt, otel-client.key and otel-ca.crt in OCSERV_SECRET_DIR.
#OCSERV_OTEL_BACKEND_ENDPOINT=otel.example.com:4317
#OCSERV_AUDIT_EVENT_KEY_ID=audit-event-v1
#
# Controller public Iroh EndpointID (64 lowercase hex) and the dedicated HTTPS
# Relay. Integrated derives OCSERV_RELAY_URL_A from OCSERV_RELAY_PUBLIC_HOST.
#OCSERV_CONTROLLER_ENDPOINT_ID=replace-with-64-lowercase-hex-controller-endpoint-id
#OCSERV_RELAY_URL_A=https://relay.example.com
#
# Protected directories outside the checkout.
#OCSERV_SECRET_DIR=/protected/ocservia-secrets
#OCSERV_BACKUP_DIR=/protected/ocservia-backups
#OCSERV_CONTROLLER_STATE_ROOT=/var/lib/ocservia-controller
#
# Backup tunables.
#OCSERV_BACKUP_INTERVAL_SECONDS=900
#OCSERV_BACKUP_RETENTION_COUNT=8
# Scheduled expired telemetry partition retirement interval (1h to 168h).
#OCSERV_TELEMETRY_RETENTION_INTERVAL=24h
#
# Database topology. PostgreSQL 18.x is the single supported database backend
# (bundled or external). External PostgreSQL 18.x requires verified TLS through
# database-ca.pem and separate owner/runtime DSNs in database-owner-url and
# database-app-url.
#OCSERV_DATABASE_DEPLOYMENT=bundled
# External PostgreSQL backup connection (not needed for bundled PostgreSQL).
#OCSERV_DATABASE_BACKUP_HOST=database.example.com
#OCSERV_DATABASE_BACKUP_PORT=5432
#OCSERV_DATABASE_BACKUP_NAME=ocservia
#OCSERV_DATABASE_BACKUP_USER=ocservia_backup
