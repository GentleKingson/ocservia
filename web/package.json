{
  "name": "@ocservia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write \"{src,test,e2e}/**/*.{ts,mjs,vue,css,json}\" \"*.{ts,json,html}\"",
    "format:check": "prettier --check \"{src,test,e2e}/**/*.{ts,mjs,vue,css,json}\" \"*.{ts,json,html}\"",
    "prelint": "npm --prefix src/api/generated run build",
    "lint": "eslint src test e2e playwright.config.ts",
    "test": "vitest run test",
    "test:e2e": "playwright test",
    "test:generated-auth": "node test/generated-client-auth.mjs",
    "typecheck": "npm --prefix src/api/generated run build && vue-tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@lucide/vue": "1.28.0",
    "@ocservia/api-client": "file:src/api/generated",
    "@vitejs/plugin-vue": "6.0.8",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.43.2",
    "@types/node": "24.10.1",
    "eslint": "10.0.1",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-tsc": "3.1.4",
    "yaml": "2.9.0"
  }
}
